<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 1.6 port. The spacer tier, which Animal Apparel: Basic Armor does not replace at any tech level.

       Research: PoweredAnimalArmor hangs off vanilla PoweredArmor plus ComplexAnimalClothing, because
       FlakAnimalArmor is not ported (Basic Armor provides flak). -->

  <ThingDef Name="AnimalSpacerBase" ParentName="ArmorMachineableBase" Abstract="True">
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisite>PoweredAnimalArmor</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
    </recipeMaker>
    <generateCommonality>0</generateCommonality>
    <thingCategories>
      <li>Animal_Apparel</li>
    </thingCategories>
    <thingSetMakerTags>
      <li>RewardSpecial</li>
    </thingSetMakerTags>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.33,0.33,0.33)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.65,0.65,0.65)</only>
        </li>
        <li>
          <weight>6</weight>
          <min>(0.3,0.3,0.3)</min>
          <max>(0.5,0.5,0.5)</max>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.9,0.9,0.9)</only>
        </li>
      </options>
    </colorGenerator>
    <apparel>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <modExtensions>
      <li Class="AnimalGear.AnimalApparelDefExtension">
        <showCoverageForBodyType>QuadrupedAnimalWithPaws</showCoverageForBodyType>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef Name="AnimalSpacerArmorBase" ParentName="AnimalSpacerBase" Abstract="True">
    <statBases>
      <WorkToMake>60000</WorkToMake>
      <MaxHitPoints>340</MaxHitPoints>
      <Mass>15</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>1.08</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.45</ArmorRating_Blunt>
      <ArmorRating_Heat>0.54</ArmorRating_Heat>
      <Insulation_Cold>34</Insulation_Cold>
      <Insulation_Heat>10</Insulation_Heat>
      <EquipDelay>15</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.4</MoveSpeed>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>AnimalBody</li>
        <li>AnimalNeck</li>
        <li>AnimalLegs</li>
      </bodyPartGroups>
      <!-- A directory, not a file stem. -->
      <wornGraphicPath>Things/Pawn/Animal/Apparel/Body/Power</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="AnimalSpacerArmorBase">
    <defName>Apparel_SmallAnimalPowerArmor</defName>
    <label>animal power armor</label>
    <description>A suit of light powered armor specially designed for combat animals. Layered plasteel-weave plates are very effective at stopping attacks, with few vulnerable joint sections. Neuro-memetic assistors allow an animal to wear the armor and still move easily.</description>
    <descriptionHyperlinks>
      <ThingDef>Alpaca</ThingDef>
      <ThingDef>Boomrat</ThingDef>
      <ThingDef>Capybara</ThingDef>
      <ThingDef>Chicken</ThingDef>
      <ThingDef>Chinchilla</ThingDef>
      <ThingDef>Cobra</ThingDef>
      <ThingDef>Fox_Arctic</ThingDef>
      <ThingDef>Fox_Fennec</ThingDef>
      <ThingDef>Fox_Red</ThingDef>
      <ThingDef>Husky</ThingDef>
      <ThingDef>Squirrel</ThingDef>
      <ThingDef>Warg</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Pawn/Animal/Apparel/Body/Power/power</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>60000</WorkToMake>
      <MaxHitPoints>300</MaxHitPoints>
      <Mass>12</Mass>
    </statBases>
    <costList>
      <ComponentSpacer>4</ComponentSpacer>
      <Plasteel>100</Plasteel>
      <Uranium>20</Uranium>
    </costList>
    <apparel>
      <tags>
        <li>AnimalApparel</li>
        <li>AnimalOnly</li>
        <li>AnimalFallbackInvisible</li>

        <li>defNameAlpaca</li>
        <li>defNameBoomrat</li>
        <li>defNameCapybara</li>
        <li>defNameChicken</li>
        <li>defNameChinchilla</li>
        <li>defNameCobra</li>
        <li>defNameFox_Arctic</li>
        <li>defNameFox_Fennec</li>
        <li>defNameFox_Red</li>
        <li>defNameHusky</li>
        <li>defNameSquirrel</li>
        <li>defNameWarg</li>

        <!-- Alpha Animals -->
        <li MayRequire="sarg.alphaanimals">defNameAA_Animalisk</li>
        <li MayRequire="sarg.alphaanimals">defNameAA_Feralisk</li>
        <li MayRequire="sarg.alphaanimals">defNameAA_Junglelisk</li>
      </tags>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="AnimalSpacerArmorBase">
    <defName>Apparel_LargeAnimalPowerArmor</defName>
