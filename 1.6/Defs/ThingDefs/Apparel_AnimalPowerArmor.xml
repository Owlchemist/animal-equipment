        <li>defNameMegasloth</li>
        <li>defNameRhinoceros</li>
        <li>defNameThrumbo</li>

        <!-- Alpha Animals -->
        <li MayRequire="sarg.alphaanimals">defNameAA_Blizzarisk</li>
        <li MayRequire="sarg.alphaanimals">defNameAA_Cinderlisk</li>
        <li MayRequire="sarg.alphaanimals">defNameAA_Dunealisk</li>
        <li MayRequire="sarg.alphaanimals">defNameAA_MeadowAve</li>
        <li MayRequire="sarg.alphaanimals">defNameAA_DesertAve</li>
        <li MayRequire="sarg.alphaanimals">defNameAA_FrostAve</li>
        <li MayRequire="sarg.alphaanimals">defNameAA_NightAve</li>
        <li MayRequire="sarg.alphaanimals">defNameAA_RoyalAve</li>

        <!-- Vanilla Factions Expanded - Vikings -->
        <li MayRequire="OskarPotocki.VFE.Vikings">defNameVFEV_Fenrir</li>
