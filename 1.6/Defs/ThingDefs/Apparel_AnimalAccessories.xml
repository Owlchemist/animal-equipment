  </ThingDef>

  <ThingDef ParentName="AnimalScarfBase">
    <defName>Apparel_LargeAnimalScarf</defName>
    <label>large animal headwear</label>
    <description>A specialized piece of headwear made of fabric or leather designed to fit a large animal.</description>
    <descriptionHyperlinks>
      <ThingDef>Cougar</ThingDef>
      <ThingDef>Cow</ThingDef>
      <ThingDef>Horse</ThingDef>
      <ThingDef>Megaspider</ThingDef>
      <ThingDef>Megasloth</ThingDef>
      <ThingDef>Muffalo</ThingDef>
      <ThingDef>Panther</ThingDef>
      <ThingDef>Thrumbo</ThingDef>
    </descriptionHyperlinks>
    <statBases>
      <WorkToMake>2400</WorkToMake>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>0.15</Mass>
    </statBases>
    <costStuffCount>50</costStuffCount>
    <apparel>
      <tags>
        <li>AnimalApparel</li>
        <li>AnimalOnly</li>
        <li>AnimalFallbackInvisible</li>

        <li>defNameCougar</li>
        <li>defNameCow</li>
        <li>defNameHorse</li>
        <li>defNameMegaspider</li>
        <li>defNameMegasloth</li>
        <li>defNameMuffalo</li>
        <li>defNamePanther</li>
        <li>defNameThrumbo</li>

        <!-- Vanilla Animals Expanded - Desert -->
        <li MayRequireAnyOf="VanillaExpanded.VAED,VanillaExpanded.VanillaAnimalsExpanded">defNameAEXP_Lion</li>
      </tags>
    </apparel>
  </ThingDef>

  <!-- +++++ Riding gear +++++ -->

  <ThingDef Name="AnimalRidingBase" ParentName="ApparelMakeableBase" Abstract="True">
    <techLevel>Neolithic</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
      <researchPrerequisite>AnimalRidingGear</researchPrerequisite>
      <recipeUsers>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
        <li>CraftingSpot</li>
      </recipeUsers>
    </recipeMaker>
    <thingCategories>
      <li>Animal_Apparel</li>
    </thingCategories>
    <generateAllowChance>0</generateAllowChance>
    <apparel>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <bodyPartGroups>
        <li>AnimalNeck</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <drawData>
        <defaultData>
          <layer>72</layer>
        </defaultData>
      </drawData>
      <defaultOutfitTags>
        <li>Anything</li>
        <li>Soldier</li>
        <li>Worker</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <colorGenerator Class="ColorGenerator_White" />
    <equippedStatOffsets>
      <MoveSpeed>0.1</MoveSpeed>
    </equippedStatOffsets>
    <modExtensions>
      <li Class="AnimalGear.AnimalApparelDefExtension">
        <showCoverageForBodyType>QuadrupedAnimalWithHooves</showCoverageForBodyType>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AnimalRidingBase">
    <defName>Apparel_bridle</defName>
    <label>riding gear</label>
    <description>Provides protection and a harness for riding.</description>
    <descriptionHyperlinks>
      <ThingDef>Elephant</ThingDef>
      <ThingDef>Horse</ThingDef>
      <ThingDef>Spelopede</ThingDef>
      <ThingDef>Thrumbo</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Pawn/Animal/Apparel/Riding/RidingGear/ridinggear</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>15000</WorkToMake>
      <MaxHitPoints>110</MaxHitPoints>
      <Mass>0.5</Mass>
      <StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.40</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.55</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <costStuffCount>60</costStuffCount>
    <stuffCategories>
      <li>Leathery</li>
    </stuffCategories>
    <costList>
      <Steel>10</Steel>
    </costList>
    <apparel>
      <!-- A directory, not a file stem. -->
      <wornGraphicPath>Things/Pawn/Animal/Apparel/Riding/RidingGear</wornGraphicPath>
      <tags>
        <li>AnimalApparel</li>
        <li>AnimalOnly</li>
        <li>AnimalFallbackInvisible</li>

        <li>defNameElephant</li>
        <!-- Horse art exists only in the released Animal Equipment, not in its GitHub
             master, and Owlchemist never added the tag to go with it. Added here. -->
        <li>defNameHorse</li>
        <li>defNameSpelopede</li>
        <li>defNameThrumbo</li>
      </tags>
    </apparel>
  </ThingDef>

</Defs>
